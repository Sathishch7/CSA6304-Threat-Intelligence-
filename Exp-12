def classify_alert(description):
    text = description.lower()

    if any(word in text for word in
           ["ransomware", "data exfiltration", "active breach"]):
        return "P1 - Critical"

    elif any(word in text for word in
             ["privilege escalation", "malware", "brute force"]):
        return "P2 - High"

    elif any(word in text for word in
             ["failed login", "port scan", "suspicious login"]):
        return "P3 - Medium"

    else:
        return "P4 - Low"


alert = input("Enter SOC alert description: ")
print("Alert Priority:", classify_alert(alert))

report = input("Enter incident report: ").lower()

areas = {
    "Patch Management": ["patch", "update", "unpatched"],
    "Security Awareness": ["training", "awareness", "employee"],
    "Monitoring": ["monitoring", "logs", "alerts"],
    "Backup Strategy": ["backup", "recovery", "restore"],
    "Access Control": ["permission", "access control", "privilege"]
}

print("Improvement Areas:")
found = False

for area, words in areas.items():
    if any(word in report for word in words):
        print("-", area)
        found = True

if not found:
    print("No matching areas found.")

def assess_intelligence(context, confidence, actionable):
    if context.strip() and confidence >= 70 and actionable:
        return "Genuine Threat Intelligence"

    return "Raw or Insufficiently Analyzed Data"


context = input("Enter threat context: ")
confidence = int(input("Enter confidence (0-100): "))
action = input("Is it actionable? (yes/no): ").lower()

result = assess_intelligence(
    context, confidence, action == "yes"
)

print("Assessment:", result)

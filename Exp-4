
def xor_cipher(data, key):
    return bytes(
        value ^ key[i % len(key)]
        for i, value in enumerate(data)
    )

message = input("Enter the message: ").encode()
key = input("Enter the shared key: ").encode()

if not key:
    print("Key cannot be empty.")
else:
    encrypted = xor_cipher(message, key)

    print("\nOriginal message:", message.decode())
    print("Captured ciphertext (hex):", encrypted.hex())

    # Demonstrate decryption using the shared key
    decrypted = xor_cipher(encrypted, key)
    print("Decrypted message:", decrypted.decode())
